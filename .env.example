# Copy this file to .env and fill in your own values. Never commit .env.
# Use it with:  uv run --env-file .env python <script>.py
# (or set the variables in your shell; see the README).

# Required for every episode that calls a real model (not needed for the tests).
OPENAI_API_KEY=your-openai-api-key-here

# Optional: point the OpenAI client at another OpenAI-compatible endpoint.
# OPENAI_BASE_URL=https://your-endpoint.example/v1

# Optional model overrides (the code has sensible defaults).
# MODEL=gpt-4o-mini
# EMBED_MODEL=text-embedding-3-small
# STT_MODEL=whisper-1
# TTS_MODEL=tts-1
# TTS_VOICE=alloy

# Episode 11: which demo patient the MCP server acts for (sara or adam).
# CLINIC_USER=sara
